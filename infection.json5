{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "infection.log"
    },
    "mutators": {
        "@default": true,
        // Sport codes are ASCII, so mb_strtolower and strtolower are
        // indistinguishable here -- no test can kill this mutant.
        "MBString": {
            "ignoreSourceCodeByRegex": [
                ".*mb_strtolower\\(\\$this->value\\).*"
            ]
        },
        // These two casts exist to make the declared PHPStan array-key types
        // truthful, not to change behaviour: PHP coerces a numeric string key
        // to int on its own, and casting a string to string is a no-op. Both
        // mutants are therefore unkillable by construction.
        "CastInt": {
            "ignore": ["FantasyPros\\Data\\Envelopes\\PlayerComparison::readRankings"]
        },
        // RankedPlayer::readRanks is the same case: objectMap hands back
        // array-key keys, and the cast makes the declared array<string, ...> key
        // type honest. The metric keys are ECR, ECR_MIN and friends, which PHP
        // never coerces to int, so removing the cast changes nothing observable.
        "CastString": {
            "ignore": [
                "FantasyPros\\Data\\Envelopes\\PlayerComparison::readRankings",
                "FantasyPros\\Data\\Api\\RankedPlayer::readRanks",
            ]
        },
        // Same story: the (float) cast on an already-numeric value is there so
        // PHPStan sees a float returned from a ?float method. PHP widens int to
        // float via the return type on its own, even under strict_types, so
        // dropping the cast is unobservable and no test can kill the mutant.
        "CastFloat": {
            "ignore": ["FantasyPros\\Data\\Infrastructure\\Payload::nullableFloat"]
        }
    },
    "timeout": 5,
    "threads": "max",
    "minMsi": 100
}
